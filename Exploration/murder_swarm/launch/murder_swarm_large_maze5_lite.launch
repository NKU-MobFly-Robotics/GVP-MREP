<launch>
  <arg name="world" default="large_maze" />
  <arg name="gui" default="true" />
  <arg name="drone_num" value="5" />

  <!-- <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find multisim_gazebo)/worlds/$(arg world).world" />
    <arg name="use_sim_time" value="true"/>
    <arg name="paused" value="false"/>
    <arg name="gui" value="$(arg gui)"/>
  </include> -->

<node pkg="rosbag" type="record" name="bag_record" args="
  /mapping_pose_1
  /mapping_pose_2
  /mapping_pose_3
  /mapping_pose_4
  /mapping_pose_5
  /mapping_pose_6
  /mapping_pose_7
  /mapping_pose_8
  /mapping_pose_9
  /mapping_pose_10
  /mapping_pose_11
  /mapping_pose_12
  /mapping_pose_13
  /mapping_pose_14
  /mapping_pose_15
  /take_off
  -o /home/charliedog/data/swarm_cd/gvp/large_maze/bags/5/gvp.bag"/>
  <include file="$(find swarm_exp_bridge)/launch/local_tcp.launch">
    <arg name="sim_id" value="1" />
    <arg name="sim_num" value="$(arg drone_num)" />
  </include>

  <!-- bandwidth statistics, clock starts on /takeoff -->
  <include file="$(find bw_statistic)/launch/bw_statistics.launch">
    <arg name="drone_num" value="$(arg drone_num)" />
    <arg name="world" value="$(arg world)" />
  </include>

  <include file="$(find murder_swarm)/launch/murder_ground_demo.launch">
    <arg name="id" value="0"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="drone_num" value="$(arg drone_num)" />
  </include>

  <!-- <node name="rvizvisualisation" pkg="rviz" type="rviz" output="screen" args="-d $(find murder_swarm)/rviz/murder_swarm_local.rviz"/> -->
  <node name="rvizvisualisation" pkg="rviz" type="rviz" output="screen" args="-d $(find murder_swarm)/rviz/ground_demo.rviz"/>

  <node pkg ="map_generator" name ="map_pub" type ="map_pub" output = "screen" args="$(find map_generator)/resource/$(arg world).pcd"/>    



 

  <!-- 100-drone grid formation (5 per row, 20 rows), identical across
       FAME/RACER/GVP: drone 3 at (0,0): x=row*spacing, y=(col-2)*spacing (row 1-5 on y-axis).
       Translate the whole formation with offset_x/y/z. -->
  <arg name="spacing" default="1.5" />
  <arg name="offset_x" default="0.0" />
  <arg name="offset_y" default="0.0" />
  <arg name="offset_z" default="0.0" />

 <include file="$(find murder_swarm)/launch/murder_single_lite.launch" if="$(eval arg('drone_num') >= 1)">
    <arg name="drone_num" value="$(arg drone_num)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="id" value="1"/>
    <arg name="init_x"   value="$(eval (0*arg('spacing') + arg('offset_x')))"/>
    <arg name="init_y"   value="$(eval (-2*arg('spacing') + arg('offset_y')))"/>
    <arg name="init_z"   value="$(eval (arg('offset_z')))"/>
  </include>

<include file="$(find murder_swarm)/launch/murder_single_lite.launch" if="$(eval arg('drone_num') >= 2)">
    <arg name="drone_num" value="$(arg drone_num)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="id" value="2"/>
    <arg name="init_x"   value="$(eval (0*arg('spacing') + arg('offset_x')))"/>
    <arg name="init_y"   value="$(eval (-1*arg('spacing') + arg('offset_y')))"/>
    <arg name="init_z"   value="$(eval (arg('offset_z')))"/>
  </include>

